DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gatekeeper
DB_SCHEMA=gatekeeper
LLM_PROVIDER=
LLM_MAX_CALLS=40
CURSOR_API_KEY=
# Optional Grok 4.5 model via Cursor: cursor-grok-4.5-high-fast
LLM_MODEL=gemini-3.7-flash-high
CURSOR_MODEL=
CURSOR_AGENT_BIN=
GEMINI_API_KEY=
GEMINI_MODEL=
XAI_API_KEY=
GROK_MODEL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_TOKEN=
# Development-only default; set a private random value outside local demos.
BLOCKLIST_PEPPER=gatekeeper-dev-pepper-change-me
CORS_ORIGINS=http://localhost:5173
DISABLE_SCHEDULER=0
